generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String  @id
  fullName    String
  email       String  @unique
  username    String  @unique
  role        String
  status      String
  createdAt   String
  lastLoginAt String?
  passwordHash String

  @@map("users")
}

model Employee {
  id             String  @id
  employeeNumber String  @unique
  firstName      String
  lastName       String
  position       String
  phone          String
  email          String?
  address        String?
  birthDate      String?
  hireDate       String?
  status         String
  createdAt      String

  @@map("employees")
}

model Mission {
  id                  String  @id
  reference           String
  orderNumber         String?
  orderYear           String?
  employeeId          String
  employeePosition    String?
  missionType         String
  subject             String
  description         String?
  serviceAssignment   String?
  departureLocation   String
  destination         String
  destinationAddress  String?
  departureDate       String  @default("")
  departureTime       String  @default("")
  returnDate          String  @default("")
  returnTime          String  @default("")
  transportation      String
  vehicleName         String?
  vehicleRegistration String?
  observations        String?
  instructions        String?
  estimatedExpenses   Float?
  attachments         String  @default("[]")
  approverId          String?
  adminComment        String?
  status              String
  version             Int     @default(1)
  approvedVersion     Int?
  rejectionReason     String?
  createdBy           String
  createdAt           String
  updatedAt           String

  @@map("missions")
}

model Approval {
  id             String  @id
  missionId      String
  approverId     String
  decision       String
  comment        String?
  previousStatus String
  version        Int
  decidedAt      String

  @@map("approvals")
}

model MissionDocument {
  id          String @id
  missionId   String
  version     Int
  filePath    String
  generatedAt String
  generatedBy String

  @@map("documents")
}

model PrintHistory {
  id              String @id
  missionId       String
  documentVersion Int
  printedBy       String
  initiatedAt     String
  status          String

  @@map("print_history")
}

model AuditLog {
  id         String  @id
  userId     String
  action     String
  entityType String
  entityId   String
  details    String?
  timestamp  String

  @@map("audit_logs")
}

model Settings {
  id   String @id
  data String

  @@map("settings")
}
